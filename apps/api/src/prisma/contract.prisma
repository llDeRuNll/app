// use prisma-8

model Workspace {
  id     String  @id @default(uuid())
  name   String
  boards Board[]
}

model Board {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(
    fields: [workspaceId],
    references: [id],
    onDelete: Cascade
  )
  tasks       Task[]
}

model Task {
  id      String @id @default(uuid())
  title   String
  boardId String
  board   Board  @relation(
    fields: [boardId],
    references: [id],
    onDelete: Cascade
  )
}