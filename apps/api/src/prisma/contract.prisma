// use prisma-8

model User {
  id           String  @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships    WorkspaceMember[]
}

model Workspace {
  id        String  @id @default(uuid())
  name      String
  ownerId   String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  owner User @relation(
    "WorkspaceOwner",
    fields:[ownerId],
    references:[id],
    onDelete: Restrict
  )

  members WorkspaceMember[]
  boards Board[]

  @@index([ownerId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  createdAt   TimestamptzString @default(now())

  workspace Workspace @relation(
    fields: [workspaceId],
    references: [id],
    onDelete: Cascade
  )
   user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@id([workspaceId, userId])
  @@index([userId])
}

model Board {
  id          String    @id @default(uuid())
  name        String
  position    Int    
  workspaceId String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  workspace   Workspace @relation(
    fields: [workspaceId],
    references: [id],
    onDelete: Cascade
  )
  tasks Task[]
    @@index([workspaceId, position])
}

model Task {
  id        String @id @default(uuid())
  title     String
  boardId   String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAt()

  board   Board  @relation(
    fields: [boardId],
    references: [id],
    onDelete: Cascade
  )
  @@index([boardId])
}